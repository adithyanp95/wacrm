# ── CRM connection ─────────────────────────────────────────────
# Your CRM's public URL (no trailing slash).
WACRM_URL=https://crm.example.com
# CRM → Settings → API keys → create a key with ONLY the `ai:agent` scope.
WACRM_API_KEY=wacrm_live_xxx
# The `secret` returned once when you registered this agent's webhook
# (POST /api/v1/webhooks with events ["message.received"]).
WACRM_WEBHOOK_SECRET=whsec_xxx

# ── Brain ─────────────────────────────────────────────────────
OPENAI_API_KEY=sk-xxx
# Optional: overrides the model chosen in CRM → Settings → AI.
# OPENAI_MODEL=gpt-5.4-mini

# ── Behaviour ─────────────────────────────────────────────────
# How long to wait for the lead to stop typing before replying (ms).
# Leads often send 2–3 short messages in a row; one reply to all of
# them reads far more human than three instant answers.
# DEBOUNCE_MS=10000
# Never wait longer than this after the first message (ms).
# MAX_WAIT_MS=30000

# Hostinger sets PORT for you.
# PORT=3001
